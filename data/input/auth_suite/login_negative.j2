{# Contoh mode folder: file ini menjadi sheet login_negative. #}
{% set ns = namespace(cases=[]) %}

{% block login_wrong_password %}
    {# ============================================================
       ID referensi (prefix LOGIN): LOGIN-002
       Key: login-wrong-password
       LOGIN — Login dengan password salah
       ============================================================ #}
    {% set precondition %}
        Akun fiktif pengguna@example.test sudah terdaftar dan aktif
        Pengguna belum memiliki sesi aktif
    {% endset %}

    {% set steps %}
        Buka halaman Login aplikasi fiktif Lentera
        Pastikan formulir Login ditampilkan
        Masukkan email pengguna@example.test
        Masukkan password fiktif Salah!234
        Klik tombol Login
    {% endset %}

    {% set expected %}
        Pesan kredensial tidak valid ditampilkan
        Pengguna tetap berada di halaman Login
    {% endset %}

    {% set _ = ns.cases.append({
        "key": "login-wrong-password",
        "dropdown": {"Kategori": {"value": "B", "options": ["A", "B", "C"]}},
        "prefix": "LOGIN",
        "feature": "Login",
        "scenario": "Login dengan password salah",
        "precondition": precondition,
        "steps": steps,
        "expected": expected,
        "priority": "P1",
        "tags": [
            "fictional",
            "negative"
        ],
        "test_data": {
            "email": "pengguna@example.test"
        },
        "test_type": "negative"
    }) %}
{% endblock login_wrong_password %}

