        "expected": expected,
        "priority": "P1",
        "tags": [
            "fictional",
            "positive"
        ],
        "test_data": {
            "email": "baru@example.test",
            "name": "Pengguna Fiktif"
        },
        "test_type": "positive"
    }) %}
{% endblock register_success %}


