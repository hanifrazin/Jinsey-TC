{# ============================================================
   VERSI LENGKAP — SATU BLOK BERISI SATU TEST CASE

   Semua precondition, steps, expected, dan data ditulis di sini.
   Tidak perlu membuka shared/ atau membaca loop untuk memahami TC.
   Setiap TC dibatasi block/endblock bernama sesuai key (strip menjadi underscore).
   key adalah identitas tetap; pertahankan saat mengedit kasus.
   ID pada komentar adalah contoh; ID aktual mengikuti registry setiap prefix.
   ID aktual tetap diberikan generator; --prefix dapat mengubahnya.
   priority: P0 / P1 / P2. tags: [] jika tidak ada.
   test_data: none jika tidak ada. Teks kosong berarti tidak diisi.

   Versi reusable tersedia di testcases_clean.j2.
   ============================================================ #}
{% set ns = namespace(cases=[]) %}



{% block login_success %}
    {# ============================================================
       ID referensi (prefix LOGIN): LOGIN-001
       Key: login-success
       LOGIN — Login dengan kredensial valid
       ============================================================ #}
    {% set precondition %}
        Akun fiktif pengguna@example.test sudah terdaftar dan aktif
        Pengguna belum memiliki sesi aktif
    {% endset %}

    {% set steps %}
        Buka halaman Login aplikasi fiktif Lentera
        Pastikan formulir Login ditampilkan
        Masukkan email pengguna@example.test
        Masukkan password fiktif Valid!234
        Klik tombol Login
    {% endset %}

    {% set expected %}
        Pengguna berhasil masuk
        Halaman utama ditampilkan
    {% endset %}

    {% set _ = ns.cases.append({
        "key": "login-success",
        "prefix": "LOGIN",
        "feature": "Login",
        "scenario": "Login dengan kredensial valid",
        "precondition": precondition,
        "steps": steps,
        "expected": expected,
        "priority": "P0",
        "tags": [
            "fictional",
            "positive"
        ],
        "test_data": {
            "email": "pengguna@example.test"
        },
        "test_type": "positive"
    }) %}
{% endblock login_success %}


